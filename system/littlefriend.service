[Unit]
Description=LittleFriend TV Engine
After=network.target sound.target local-fs.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/LittleFriend
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi/.Xauthority

# Allow non-root 'pi' user to run the Web companion on Port 80
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Run on unallocated Virtual Terminal 2 (bypasses getty@tty1 conflict)
ExecStart=/usr/bin/xinit /home/pi/LittleFriend/venv/bin/python /home/pi/LittleFriend/main.py -- :0 -nocursor vt2

Restart=on-failure
RestartSec=3s

[Install]
WantedBy=multi-user.target